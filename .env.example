# Database
MANIGIT_DB_PATH=data/database/manigit.db

# Model Adapter Configuration (provider-agnostic)
MANIGIT_MODEL_PROVIDER=mock
MANIGIT_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Context Compiler Defaults
MANIGIT_DEFAULT_TOKEN_BUDGET=4096
